# Copy to .env and fill in real values:
#   copy .env.example .env
#
# Then:
#   docker compose up -d

JWT_SECRET=local-dev-secret-change-me

# LinkedIn — https://www.linkedin.com/developers/apps
# Products: Share on LinkedIn + Sign In with LinkedIn using OpenID Connect
# Redirect: http://localhost:5000/integrations/social/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Reddit — https://www.reddit.com/prefs/apps (web app)
# Redirect: http://localhost:5000/integrations/social/reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
