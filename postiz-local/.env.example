# Copy to .env and fill in real values:
#   copy .env.example .env
#
# Then:
#   docker compose up -d

JWT_SECRET=local-dev-secret-change-me

# LinkedIn — https://www.linkedin.com/developers/apps
# Products: Share on LinkedIn + Sign In with LinkedIn using OpenID Connect
# Redirect: http://localhost:5000/integrations/social/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Dev.to and Hashnode connect with per-user API keys in Indie Takeoff (no env vars).
